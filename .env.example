# --- Needed at BUILD time (metadata for posters, years, seasons) ---
# TMDB: https://www.themoviedb.org/settings/api  (v3 API key or v4 read token both work)
TMDB_API_KEY=
# RAWG: https://rawg.io/apidocs
RAWG_API_KEY=

# --- Needed at RUNTIME (visitor recommendations + admin) ---
# Supabase project URL, e.g. https://abcdxyz.supabase.co
SUPABASE_URL=
# Supabase "service_role" key (Project settings -> API). Server-side only, never put it in the frontend.
SUPABASE_SERVICE_KEY=
# Long random string (16+ chars) you type into /admin to log in
ADMIN_TOKEN=
# Any random string, used to hash visitor IPs for rate limiting
IP_SALT=

# --- Optional ---
# Cloudflare Turnstile secret (and put the site key in public/config.js)
TURNSTILE_SECRET=
# Discord webhook that pings you when a new rec arrives
DISCORD_WEBHOOK_URL=
